---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ nfs_namespace }}

---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ nfs_pvc_name }}-pv
spec:
  capacity:
    storage: {{ nfs_pvc_size }}
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: manual-nfs
  hostPath:
    path: {{ nfs_host_path }}
    type: DirectoryOrCreate

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ nfs_pvc_name }}
  namespace: {{ nfs_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: manual-nfs
  resources:
    requests:
      storage: {{ nfs_pvc_size }}

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nfs-server
  namespace: {{ nfs_namespace }}
  labels:
    app: nfs-server
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: nfs-server
  template:
    metadata:
      labels:
        app: nfs-server
    spec:
      nodeSelector:
        kubernetes.io/hostname: {{ nfs_node_name }}
      tolerations:
        - key: "node-role.kubernetes.io/master"
          operator: "Exists"
          effect: "NoSchedule"
        - key: "node-role.kubernetes.io/control-plane"
          operator: "Exists"
          effect: "NoSchedule"
      containers:
        - name: nfs-server
          image: {{ nfs_server_image }}
          command: ["/bin/sh", "-c"]
          args:
            - |
              echo ">>> starting rpcbind"
              rpcbind

              echo ">>> configuring lockd ports"
              echo 32803 > /proc/sys/fs/nfs/nlm_tcpport
              echo 32769 > /proc/sys/fs/nfs/nlm_udpport

              echo ">>> starting statd"
              rpc.statd --port 662 --outgoing-port 2020

              echo ">>> starting nfsd (v3 only)"
              rpc.nfsd -N 4 -V 3

              echo ">>> starting mountd"
              rpc.mountd -F -p 20048 -N 4 -V 3 &

              echo ">>> exporting filesystem"
              mkdir -p {{ nfs_share_dir | default("/nfs-share") }}
              chmod 777 {{ nfs_share_dir | default("/nfs-share") }}

              echo "{{ nfs_share_dir | default("/nfs-share") }} *(rw,sync,no_subtree_check,no_root_squash,insecure)" > /etc/exports
              exportfs -rv

              echo ">>> NFS server ready"
              tail -f /dev/null
          ports:
            - name: nfs-tcp
              containerPort: 2049
              protocol: TCP
            - name: nfs-udp
              containerPort: 2049
              protocol: UDP
            - name: mountd-tcp
              containerPort: 20048
              protocol: TCP
            - name: mountd-udp
              containerPort: 20048
              protocol: UDP
            - name: rpc-tcp
              containerPort: 111
              protocol: TCP
            - name: rpc-udp
              containerPort: 111
              protocol: UDP
          securityContext:
            privileged: true
          volumeMounts:
            - mountPath: {{ nfs_export_path }}
              name: nfs-data
      volumes:
        - name: nfs-data
          persistentVolumeClaim:
            claimName: {{ nfs_pvc_name }}

---
apiVersion: v1
kind: Service
metadata:
  name: nfs-server
  namespace: {{ nfs_namespace }}
spec:
  type: NodePort
  ports:
    - name: nfs-tcp
      port: 2049
      targetPort: 2049
      nodePort: {{ nfs_node_port }}
      protocol: TCP
    - name: nfs-udp
      port: 2049
      targetPort: 2049
      protocol: UDP
    - name: mountd-tcp
      port: 20048
      targetPort: 20048
      nodePort: {{ nfs_mount_node_port }}
      protocol: TCP
    - name: mountd-udp
      port: 20048
      targetPort: 20048
      nodePort: {{ nfs_mount_node_port }}
      protocol: UDP
    - name: rpc-tcp
      port: 111
      targetPort: 111
      protocol: TCP
    - name: rpc-udp
      port: 111
      targetPort: 111
      protocol: UDP
  selector:
    app: nfs-server


---
