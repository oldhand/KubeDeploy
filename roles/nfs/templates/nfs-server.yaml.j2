---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ nfs_namespace }}

---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ nfs_pvc_name }}-pv
spec:
  capacity:
    storage: {{ nfs_pvc_size }}
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: manual-nfs
  hostPath:
    path: {{ nfs_host_path }}
    type: DirectoryOrCreate

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ nfs_pvc_name }}
  namespace: {{ nfs_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: manual-nfs
  resources:
    requests:
      storage: {{ nfs_pvc_size }}

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nfs-server
  namespace: {{ nfs_namespace }}
  labels:
    app: nfs-server
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: nfs-server
  template:
    metadata:
      labels:
        app: nfs-server
    spec:
      nodeSelector:
        kubernetes.io/hostname: {{ nfs_node_name }}
      tolerations:
        - key: "node-role.kubernetes.io/master"
          operator: "Exists"
          effect: "NoSchedule"
        - key: "node-role.kubernetes.io/control-plane"
          operator: "Exists"
          effect: "NoSchedule"
      containers:
        - name: nfs-server
          image: {{ nfs_server_image }}
          command: ["/bin/sh", "-c"]
          args:
            - |
              # 1. 将镜像自带的启动脚本放入后台运行
              /bin/nfsd.sh &
              
              # 2. 睡眠 3 秒，等待自带脚本把默认的 exports 写入完毕
              sleep 3
              
              # 3. 强行覆盖掉它的配置，换成我们需要的高权限 (rw 和 no_root_squash)
              echo "{{ nfs_export_path }} *(rw,sync,no_subtree_check,no_root_squash,fsid=0)" > /etc/exports
              
              # 4. 动态刷新 NFS 配置，使其立刻在内核生效
              exportfs -ar
              
              # 5. 挂起主进程，防止容器异常退出
              wait
          ports:
            - name: nfs-tcp
              containerPort: 2049
              protocol: TCP
            - name: nfs-udp
              containerPort: 2049
              protocol: UDP
            - name: mountd-tcp
              containerPort: 20048
              protocol: TCP
            - name: mountd-udp
              containerPort: 20048
              protocol: UDP
            - name: rpc-tcp
              containerPort: 111
              protocol: TCP
            - name: rpc-udp
              containerPort: 111
              protocol: UDP
          securityContext:
            privileged: true
          volumeMounts:
            - mountPath: {{ nfs_export_path }}
              name: nfs-data
      volumes:
        - name: nfs-data
          persistentVolumeClaim:
            claimName: {{ nfs_pvc_name }}

---
apiVersion: v1
kind: Service
metadata:
  name: nfs-server
  namespace: {{ nfs_namespace }}
spec:
  type: NodePort
  ports:
    - name: nfs-tcp
      port: 2049
      targetPort: 2049
      nodePort: {{ nfs_node_port }}
      protocol: TCP
    - name: nfs-udp
      port: 2049
      targetPort: 2049
      protocol: UDP
    - name: mountd-tcp
      port: 20048
      targetPort: 20048
      protocol: TCP
    - name: mountd-udp
      port: 20048
      targetPort: 20048
      protocol: UDP
    - name: rpc-tcp
      port: 111
      targetPort: 111
      protocol: TCP
    - name: rpc-udp
      port: 111
      targetPort: 111
      protocol: UDP
  selector:
    app: nfs-server